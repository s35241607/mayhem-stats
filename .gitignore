__pycache__/
*.pyc

# 採集下來的個人對戰資料庫(含同場其他玩家的名稱與 puuid),只留在本機
mayhem.db
mayhem.db-wal
mayhem.db-shm

# 開機自動啟動的執行記錄
autostart.log
autostart.log.old
autostart.err
mirror.log
mirror.log.old

# Cube 語意層
cube/node_modules/
cube/.cubestore/
# 輪替出來的舊 log 也要擋：內容有完整查詢，包含 puuid 與同場玩家的 Riot ID
cube/cube.log
cube/cube.log.*
cube/.env

# 前端。web/dist 是建置產物，不進版控（每次建置檔名都換，曾佔掉 repo 八成的大小）；
# clone 後要先在 web/ 跑 npm ci && npm run build，見 README。
web/dist/
web/node_modules/
web/.vite/
*.tsbuildinfo

# 圖示快取（抓過就不必再問客戶端，可安全刪除）
icon_cache/

# 公開模式的代號鹽：換掉它所有代號會重洗，不進版控
.public_salt

# 公開鏡像的密碼，不進版控
.public_password

# Discord 登入的 client id/secret 與白名單，不進版控
.public_oauth

# 公開鏡像的登入 session(只存 token 雜湊)與「這是我」的綁定
.public_state.db
.public_state.db-journal

# Playwright 端對端測試的產物
web/test-results/
web/playwright-report/

# 全站預設查詢區間（管理員在畫面上設定，執行期資料）
.site_config.json
.site_config.tmp

# 自由探索存下來的分析與儀表板（篩選值可能含玩家名稱）
.explore_items.json
.explore_items.tmp

# 驗證時的截圖、效能量測等暫存（scratch），不進版控
.tmp/
/*.png
